parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$answer of static method Omnilab\\Source\\Stac\:\:page\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: CopernicusSource.php

		-
			message: '#^Cannot cast mixed to float\.$#'
			identifier: cast.double
			count: 1
			path: CopernicusSourceFactory.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: CopernicusSourceFactory.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''strval'' given\.$#'
			identifier: argument.type
			count: 1
			path: CopernicusSourceFactory.php

		-
			message: '#^Cannot access property \$alternates on Omnilab\\Model\\Asset\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot access property \$href on Omnilab\\Model\\Asset\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot access property \$roles on Omnilab\\Model\\Asset\|null\.$#'
			identifier: property.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot access property \$type on Omnilab\\Model\\Asset\|null\.$#'
			identifier: property.nonObject
			count: 2
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot call method contains\(\) on Omnilab\\Model\\BBox\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot call method format\(\) on DateTimeImmutable\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Cannot call method httpsHref\(\) on Omnilab\\Model\\Asset\|null\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Method Omnilab\\Copernicus\\Tests\\CopernicusSourceTest\:\:source\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Offset ''type'' might not exist on array\<string, mixed\>\|null\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnilab\\Source\\SourceFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Parameter \#2 \$string of static method PHPUnit\\Framework\\Assert\:\:assertStringStartsWith\(\) expects string, string\|null given\.$#'
			identifier: argument.type
			count: 2
			path: Tests/CopernicusSourceTest.php

		-
			message: '#^Property Omnilab\\Copernicus\\Tests\\CopernicusSourceTest\:\:\$calls \(list\<array\<string, string\>\>\) does not accept non\-empty\-list\<array\<int\|string, array\<mixed\>\|string\>\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Tests/CopernicusSourceTest.php
